# Groq API Configuration (Backend Only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Cloud API Configuration (Backend Only)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=sechindsight

# Supabase PostgreSQL Configuration (Backend Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Application Database URL (PostgreSQL or SQLite Fallback)
DATABASE_URL=sqlite+aiosqlite:///./sec_hindsight.db

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
